+def _get_user_plugin_dir() -> Path:
+    """Return ``~/.clawcodex/plugins`` (XDG-compatible)."""
+    xdg = os.environ.get('CLAWCODEX_PLUGINS_DIR')
+    if xdg:
+        return Path(xdg)
+    return Path.home() / '.clawcodex' / 'plugins'
