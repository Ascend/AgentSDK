+def __getattr__(name: str):  # noqa: D401 - PEP 562 lazy attribute
+    """Lazily resolve heavy agent exports on first attribute access.
+
+    ``src/agent/__init__.py`` historically ran ~14 heavy imports (plugins,
+    prompt, providers, run_agent, ...) at module load. Anything that did
+    ``import src.agent`` or ``from src.agent.X import Y`` paid the full
+    ~2.2s cold-start cost, even when it only needed the lightweight
+    ``Conversation`` class. Stage 6 perf budget for
+    ``from src.agent.conversation import Conversation`` is 2.0s; lazy
+    attribute access keeps the import path under that threshold by only
+    paying the heavy cost when callers actually touch those names.
+    """
+    target = _LAZY_ATTRS.get(name)
+    if target is None:
+        raise AttributeError(f"module 'src.agent' has no attribute {name!r}")
+    module_name, attr = target
+    import importlib
+
+    module = importlib.import_module(module_name)
+    value = getattr(module, attr)
+    # Cache in module __dict__ so subsequent lookups are O(1).
+    globals()[name] = value
+    return value
+
 
