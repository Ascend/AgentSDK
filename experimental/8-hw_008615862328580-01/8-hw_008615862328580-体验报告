三、关键步骤与命令
# 1) 环境：所有产物与缓存指向 300G 可写盘 /workspace（根 overlay 仅 5G）
export HF_HOME=/workspace/.cache/huggingface
export HF_DATASETS_CACHE=/workspace/.cache/huggingface/datasets
export TMPDIR=/workspace/tmp RAY_TMPDIR=/workspace/tmp/ray

# 2) 数据集预处理（预置数据为 parquet，含 main/ 子目录）
python3 /verl/examples/data_preprocess/gsm8k.py \
  --local_dataset_path /workspace/shared_assets/MindSDKMeetup/dataset/gsm8k \
  --local_save_dir /workspace/data/gsm8k-output

# 3) 训练 yaml 中四处必改路径
#   hydra.searchpath  -> file:///workspace/AgentSDK/aura/configs/train/verl_conf
#   data.train_files  -> /workspace/data/gsm8k-output/train.parquet
#   data.val_files    -> /workspace/data/gsm8k-output/test.parquet
#   actor_rollout_ref.model.path -> /workspace/shared_assets/MindSDKMeetup/model/Qwen3-14B

# 4) hosts.conf（本机 IP, index, train_master, infer_master）
179.52.56.133,0,1,1

# 5) base.conf：work_mode=hybrid；train_config_name=verl_train_hybrid_A2_t8_qwen3_14b_math_fsdp
#    env.local：DEFAULT_SOCKET_IFNAME=eth0；ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# 6) 后台启动训练（WebIDE 无 tmux，用 nohup）
cd /workspace/AgentSDK/aura
nohup bash scripts/start_rl_with_verl_vllm.sh > /workspace/train_start.log 2>&1 &

# 7) 打开 TensorBoard（logdir 必须指向目录，而非事件文件）
tensorboard --logdir /workspace/AgentSDK/aura/tensorboard_log \
  --host 0.0.0.0 --port 6006
